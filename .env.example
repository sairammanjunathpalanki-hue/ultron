# ===================================================
# ULTRON COMMAND CENTER CONFIGURATION
# ===================================================

# OpenAI API Key for GPT-6 Astra / Responses / Vision
OPENAI_API_KEY=

# Target Primary Model (defaults to gpt-6-astra, auto-fallbacks to gpt-4o if unentitled)
MODEL=gpt-6-astra
FALLBACK_MODEL=gpt-4o

# Voice Configuration
VOICE_NAME=alloy
VOICE_SPEED=1.0

# Server Port
PORT=3001
HOST=0.0.0.0

# Sandbox Directory for local file tools, docs, and project inspection
SANDBOX_PATH=./sandbox
